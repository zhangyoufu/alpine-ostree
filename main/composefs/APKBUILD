# Maintainer: Youfu Zhang <zhangyoufu@gmail.com>
pkgname=composefs
pkgver=1.0.8
pkgrel=0
pkgdesc="A file system for mounting container images"
url="https://github.com/composefs/composefs"
arch="all"
license="GPL-2.0-only OR Apache-2.0"
# this build replaces the official package of the same name (if any)
replaces="composefs"
makedepends="meson fuse3-dev openssl-dev linux-headers"
options="!check !doc"
subpackages="$pkgname-dev $pkgname-dbg"
source="https://github.com/composefs/composefs/releases/download/v$pkgver/composefs-$pkgver.tar.xz"
builddir="$srcdir/composefs-$pkgver"
sha512sums="
d8485788d9c41262223d69688a78a7529305585efd4ef90ea4ff21b53d226f7145ca793f92ff53bc503b606f4d546378268145ad4abf2b82351741b028269d22  composefs-1.0.8.tar.xz
"

build() {
	meson setup \
		--prefix=/usr \
		--libdir=/usr/lib \
		--buildtype=plain \
		-Dman=disabled \
		-Dfuse=disabled \
		build
	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install -C build
}

dev() {
	default_dev
}
