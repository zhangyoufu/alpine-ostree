# Contributor: André Klitzing <aklitzing@gmail.com>
# Maintainer: Youfu Zhang <zhangyoufu@gmail.com>
pkgname=ostree
pkgver=2026.2
pkgrel=1
pkgdesc="Operating system and container binary deployment and upgrades"
url="https://github.com/ostreedev/ostree"
arch="all"
license="LGPL-2.0-or-later"
makedepends="
	composefs-dev
	bison
	curl-dev
	e2fsprogs-dev
	fuse3-dev
	gobject-introspection-dev
	gpgme-dev
	gtk-doc
	libarchive-dev
	libsoup3-dev
	libxslt
	linux-headers
	openssl-dev>3
	xz-dev
	"
checkdepends="
	bash
	coreutils
	"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-dbg
	$pkgname-gir
	$pkgname-grub:grub:noarch
	$pkgname-bash-completion:bashcomp:noarch
	$pkgname-mkinitfs::noarch
	"
options="!check"
source="https://github.com/ostreedev/ostree/releases/download/v$pkgver/libostree-$pkgver.tar.xz"
builddir="$srcdir/lib$pkgname-$pkgver"
sha512sums="
5f1c6602e5a04b4b700fa1b2f79aac1f9955cc22a65120cf570a93e626a42743ee05d9b1102c450778010c105290d8eb9c30aa15c054106eb77ac44936f5eed7  libostree-2026.2.tar.xz
"

prepare() {
	default_prepare
	update_config_sub
}

build() {
	CFLAGS="$CFLAGS -flto=auto" \
	CXXFLAGS="$CXXFLAGS -flto=auto" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--sbindir=/usr/bin \
		--libexecdir=/usr/lib \
		--enable-gtk-doc \
		--enable-introspection \
		--disable-static \
		--disable-glibtest \
		--with-curl \
		--with-openssl \
		--with-soup3 \
		--with-composefs=yes
	make
	make ostree-trivial-httpd
}

package() {
	make DESTDIR="$pkgdir" install

	# the libtool wrapper is not usable at runtime; install the real binary
	install -Dm755 "$builddir"/.libs/ostree-trivial-httpd \
		-t "$pkgdir"/usr/bin/
	# the builtin grub generator is only installed by upstream when
	# --with-builtin-grub2-mkconfig is used; ship it so it can be selected
	# at runtime via OSTREE_GRUB2_EXEC=builtin
	install -Dm755 "$builddir"/src/boot/grub2/ostree-grub-generator \
		-t "$pkgdir"/usr/lib/ostree/
}

dev() {
	default_dev
}

grub() {
	pkgdesc="GRUB2 integration for OSTree"
	install_if="$pkgname=$pkgver-r$pkgrel grub"

	amove etc/grub.d/*
	amove usr/lib/libostree/grub2-*
}

bashcomp() {
	depends=""
	pkgdesc="Bash completions for $pkgname"
	install_if="$pkgname=$pkgver-r$pkgrel bash-completion"

	amove usr/share/bash-completion
}

gir() {
	depends="gobject-introspection"
	pkgdesc="$pkgname (GObject-Introspection metadata)"

	amove usr/lib/girepository-1.0/OSTree-1.0.typelib
}

mkinitfs() {
	depends="$pkgname=$pkgver-r$pkgrel mkinitfs"
	install_if="$pkgname=$pkgver-r$pkgrel mkinitfs"
	pkgdesc="$pkgname module for mkinitfs"

	mkdir -p "$subpkgdir"/etc/mkinitfs/features.d
	echo "/usr/lib/ostree/ostree-prepare-root" \
		> "$subpkgdir"/etc/mkinitfs/features.d/ostree.files
}
